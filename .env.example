### this .env should be at the repo root, not in a service repo ###

e.g. IMAGE_PREFIX=ghcr.io/ziyadsamhaoui/.
IMAGE_PREFIX=

AUTH_TAG=local
USER_TAG=local
CHAT_TAG=local
REALTIME_TAG=local
NOTIFICATION_TAG=local
ATTACHMENT_TAG=local
GATEWAY_TAG=local
FRONTEND_TAG=local


INTERNAL_HMAC_SECRET=change_me_to_a_long_random_string


POSTGRES_AUTH_PASSWORD=auth_service_pw
POSTGRES_USER_PASSWORD=user_service_pw
POSTGRES_NOTIFICATION_PASSWORD=notification_service_pw
POSTGRES_ATTACHMENT_PASSWORD=attachment_service_pw
MONGO_ROOT_PASSWORD=secret


MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ATTACHMENT_BUCKET=badrlink-attachments
MINIO_QUARANTINE_BUCKET=badrlink-quarantine


NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws
CORS_ALLOWED_ORIGINS=http://localhost:3000


PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@badrlink.local
